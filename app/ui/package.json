{
  "name": "tree-factory-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run check:icons",
    "test:e2e": "playwright test",
    "regression": "vitest run -t M01",
    "check:icons": "node scripts/check-design-icons.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "svelte-check --tsconfig ./tsconfig.json --threshold warning && npm run check:icons"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
