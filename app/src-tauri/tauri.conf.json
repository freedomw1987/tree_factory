{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tree-factory",
  "version": "0.1.0",
  "identifier": "com.treefactory.spike",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "收音探針 (SPIKE-002)",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "infoPlist": "Info.plist"
    }
  }
}
