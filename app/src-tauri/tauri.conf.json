{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tree-factory",
  "version": "0.1.0",
  "identifier": "com.treefactory.spike",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "if [ -d ui ]; then npm --prefix ui run dev; else npm --prefix ../ui run dev; fi",
    "beforeBuildCommand": "if [ -d ui ]; then npm --prefix ui run build; else npm --prefix ../ui run build; fi"
  },
  "app": {
    "windows": [
      {
        "title": "tree-factory",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "infoPlist": "Info.plist"
    }
  }
}
